<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    tools:context=".MainActivity">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv1"
        android:text="Hostel Name"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv2"
        android:layout_below="@id/tv1"
        android:text="Campus Hostel 1"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv3"
        android:layout_below="@id/tv2"
        android:text="Student Name"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv4"
        android:layout_below="@id/tv3"
        android:text="Sushaant Verma"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv5"
        android:layout_below="@id/tv4"
        android:text="Registration Number"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv6"
        android:layout_below="@id/tv5"
        android:text="12310774"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv7"
        android:layout_below="@id/tv6"
        android:text="Check-in-Date"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tv8"
        android:layout_below="@id/tv7"
        android:text="10 September 2025"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <EditText
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:id="@+id/et1"
        android:layout_below="@id/tv8"
        android:hint="Pending Amount"
        android:layout_marginTop="12dp"
        tools:ignore="HardcodedText" />
    <ImageView
        android:layout_width="120dp"
        android:layout_height="150dp"
        android:id="@+id/iv1"
        android:layout_alignParentEnd="true"
        android:layout_alignBottom="@id/et1"
        android:src="@drawable/photo"/>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/bt1"
        android:layout_below="@id/et1"
        android:layout_marginTop="25dp"
        android:text="BOOK"
        android:backgroundTint="@color/black"
        tools:ignore="HardcodedText" />

</RelativeLayout>